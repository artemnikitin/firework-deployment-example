gcp_project   = "my-gcp-project"
gcp_region    = "us-central1"
dns_zone_name = "firework-gcp"
# When moving the data plane to another region within the same VPC, choose a
# non-overlapping range so Terraform can create the new subnet before retiring
# the old regional MIG. For example: 10.31.0.0/24.
# network_cidr = "10.31.0.0/24"
# Single source of truth for wildcard DNS, the wildcard TLS certificate, and the
# agent ingress_domain. Services route as <subdomain>.<base_domain>.
base_domain       = "gcp.example.com"
images_bucket_name = "firework-images-amd64-my-gcp-project"

# The default local-state wiring reads these from terraform/control-plane/gcp.
# Uncomment only when the control-plane state file is intentionally unavailable.
# config_bucket_name                 = "firework-cp-state-my-gcp-project"
# config_prefix                      = "cp/v1/"
# registry_url                       = "https://34.0.0.1:9443"
# registry_server_name               = "34.0.0.1"
# registry_ca_secret_id              = "firework-cp-enrollment-ca-cert"
# registry_bootstrap_token_secret_id = "firework-cp-bootstrap-token"

node_machine_type = "n4-standard-8"
node_count        = 3
# Optional. Any two or more distinct zones of gcp_region, in any order.
# Omit to use every zone the region reports as UP. Pinned here to avoid the
# exhausted us-central1-c pool.
node_zones = [
  "us-central1-a",
  "us-central1-b",
  "us-central1-f",
]

# Persistent storage is disabled by default. Enable either block independently.
# Local volumes use a retained stateful Hyperdisk Balanced disk per MIG instance.
# enable_local_storage   = true
# local_storage_size_gib = 500
# local_storage_capacity = "450Gi"

# Shared volumes use Regional Filestore with NFSv4.1. Provisioned Filestore
# capacity is resized separately from application quotas.
# enable_shared_storage         = true
# shared_storage_backend_id     = "primary"
# shared_storage_capacity       = "900Gi"
# filestore_tier                = "REGIONAL"
# filestore_capacity_gib        = 1024
# filestore_deletion_protection = true
