# Copy this file to terraform.tfvars and fill in the values.

aws_region   = "us-east-1"
project_name = "firework-example"

# Root domain for DNS records and the wildcard ACM certificate. Also the single
# source of truth for the agent ingress_domain: services route as
# <subdomain>.<domain_name>.
# A Route53 hosted zone for this domain must already exist in your account.
domain_name = "example.com"

# Availability zones — update if deploying to a different region.
# availability_zones = ["us-east-1a", "us-east-1c"]

# Where Firecracker nodes run. "public" (default) uses internet gateway egress
# and creates no NAT gateways — the cheapest option at demo scale. Read the
# security trade-offs in README.md before keeping it: source/destination check
# is disabled on these nodes, so the security group is the only inbound barrier.
# Use "private" for anything beyond a demo.
# node_network_placement = "public"

# NAT topology, only used when node_network_placement = "private".
# "per_az" (default) survives a single-AZ failure; "single" is cheaper but adds
# an AZ dependency and cross-AZ charges for non-S3 egress.
# nat_gateway_mode = "per_az"

# Auto-wire control-plane outputs from local state (recommended).
# If your control-plane state is elsewhere, update control_plane_state_path or
# set use_control_plane_remote_state = false and provide manual overrides below.
use_control_plane_remote_state = true
control_plane_state_path       = "../../control-plane/aws/terraform.tfstate"

# Optional manual overrides (normally auto-wired from control-plane outputs):
# Note: when control-plane outputs are present, they are preferred for
# s3_configs_bucket_id/s3_configs_bucket_arn/s3_configs_prefix.
# s3_configs_bucket_id  = "firework-example-configs-xxxx"
# s3_configs_bucket_arn = "arn:aws:s3:::firework-example-configs-xxxx"
# s3_configs_prefix     = "cp/v1/"
# registry_url          = "https://registry.example.com:9443"
# registry_server_name  = "registry.example.com"

# Preferred: step-ca bootstrap (AWS IID, no registry bootstrap token on nodes).
# Usually auto-wired from control-plane outputs; uncomment only to override.
# step_ca_url                = "https://pki.example.internal:9000"
# step_ca_root_ca_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:firework-step-ca-root-ca-xxxxx"
# step_ca_provisioner        = "aws-iid"
# step_ca_subject_suffix     = ".node.firework.internal"
# step_ca_renew_expires_in   = "8h"

# Legacy fallback (registry enrollment token path).
# Usually auto-wired from control-plane outputs; uncomment only to override.
# registry_client_ca_secret_arn       = "arn:aws:secretsmanager:us-east-1:123456789012:secret:firework-node-client-ca-xxxxx"
# registry_bootstrap_token_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:firework-bootstrap-token-xxxxx"

# Pre-existing images bucket managed by CI (not created by Terraform).
# Create once: aws s3 mb s3://<name> --region us-east-1
s3_images_bucket_id  = "your-images-bucket-name"
s3_images_bucket_arn = "arn:aws:s3:::your-images-bucket-name"

# Node AMI selection (pick one source).
#
# Option A: explicit AMI ID.
# node_ami_id = "ami-0123456789abcdef0"
#
# Option B: latest AMI by name pattern in AWS (partial names are supported).
# Terraform wraps patterns without wildcards as *pattern*.
# node_ami_name_pattern = "firework-node"
# node_ami_owners       = ["self"]
#
# Option C: latest AMI from local Packer manifest (enabled by default).
# use_packer_manifest_ami = true
# packer_manifest_path    = "../../../packer/aws/manifest.json"

node_key_name = "my-key-pair"

# Instance type must expose /dev/kvm for Firecracker: either a bare-metal type,
# or a virtual Intel type with node_nested_virtualization = true.
# c8i.2xlarge = Intel, 8 vCPUs, 16 GB RAM — roughly 6x cheaper per hour than the
# smallest Graviton metal SKU, which is 64 vCPUs whether you need them or not.
node_instance_type         = "c8i.2xlarge"
node_nested_virtualization = true

# To use bare-metal Graviton nodes instead, all three must change together and
# the AMI must be rebuilt with architecture = "arm64". s3_images_bucket_id is
# unchanged: the bucket holds every architecture under an <arch>/ key prefix and
# the agent reads the one matching its node.
# node_instance_type         = "c6g.metal"
# node_nested_virtualization = false
# node_ami_architecture      = "arm64"

# Number of Firecracker nodes.
node_count = 2

# Persistent storage is disabled by default. Enable either block independently.
# Local volumes use a retained encrypted gp3 disk per node.
# enable_local_storage   = true
# local_storage_size_gib = 500
# local_storage_capacity = "450Gi"

# Shared volumes use encrypted regional EFS mounted on every node. The
# Firework shared runtime remains pending until its fencing safety gate lands.
# enable_shared_storage          = true
# shared_storage_backend_id      = "primary"
# shared_storage_capacity        = "1Ti" # optional admission/cost budget
# shared_storage_use_access_point = true

# Guest networking (defaults match the agent's built-in defaults).
# vm_subnet  = "172.16.0.0/24"
# vm_gateway = "172.16.0.1"
